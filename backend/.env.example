# ============================================================
# Brinjal Detection – Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ============================================================
# Database (SQLAlchemy async)
# ============================================================
# Default: SQLite at backend/data/agrisense.db (auto-created, zero config)
# DATABASE_URL=sqlite+aiosqlite:///./data/agrisense.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agrisense
# pip install asyncpg

# MySQL / MariaDB:
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/agrisense
# pip install aiomysql

# Log SQL queries to console (debug only):
# DB_ECHO=false


# ============================================================
# Google Earth Engine Authentication
# ============================================================
# Option 1: Service Account (recommended for server deployment)
# Create a service account in Google Cloud Console,
# grant it "Earth Engine" access, download the JSON key,
# and place it somewhere safe (NOT in the repo).
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_FILE=/path/to/service-account-key.json

# Option 2: Personal authentication token
# Run `earthengine authenticate` locally. The token is stored
# at ~/.config/earthengine/credentials by default.
# Leave the above fields empty to fall back to this method.

# Google Cloud Project ID (required for GEE)
GEE_PROJECT_ID=your-google-cloud-project-id

# ============================================================
# Application Settings
# ============================================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# ML Settings
# ============================================================
# Maximum number of training samples per class
MAX_SAMPLES_PER_CLASS=500
# Default RF estimators
DEFAULT_N_ESTIMATORS=200
# Model storage directory
MODEL_DIR=./saved_models

# ============================================================
# Data Limits
# ============================================================
# Maximum uploaded file size in MB
MAX_UPLOAD_SIZE_MB=50
# Maximum AOI area in square kilometres
MAX_AOI_AREA_KM2=50000

# ============================================================
# Sentinel-2 Defaults
# ============================================================
DEFAULT_CLOUD_THRESHOLD=20
DEFAULT_NDVI_THRESHOLD=0.25
DEFAULT_SCALE_METERS=30

# ============================================================
# Planet Labs (optional – real credentials required)
# ============================================================
# Obtain from https://www.planet.com/account/#/user-settings
# Leave blank to disable Planet integration in the UI.
# We do NOT fake Planet imagery – it is only used with valid credentials.
PLANET_API_KEY=

# ============================================================
# Cloud Deployment (production)
# ============================================================
# Uncomment and set for production:
# SECRET_KEY=<generate with: python -c "import secrets; print(secrets.token_hex(32))">
# ALLOWED_HOSTS=your-domain.com
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Docker / reverse-proxy settings
# APP_HOST=0.0.0.0
# APP_PORT=8000

# ============================================================
# Notes
# ============================================================
# NEVER commit this file with real values to version control.
# Use environment variables or a secrets manager in production.
# Excluded paths (.venv, venv, node_modules, saved_models, *.pem)
# are listed in the root .gitignore.
